@model Application.ViewModels.RetiroVewModel

<div class="row">
    <div class="col-4 offset-4">
        <div class="card">
            <div class="card-header bg-primary text-light">
                <strong>Retira Dinero</strong>
            </div>
            <div class="card-body">
                <form method="post" asp-controller="Cajero" asp-action="Retiro">
                    <input type="hidden" asp-for="configuracion" />
                    <div class="mb-3">
                        <label asp-for="monto" class="form-label">Monto:</label>
                        <input asp-for="monto" class="form-control" />
                    </div>
                    <div>
                        <button type="submit" class="btn btn-outline-primary float-end">Retirar</button>
                        <a asp-controller="Cajero" asp-action="Index" class="btn btn-outline-warning float-end me-2">Volver</a>                  
                    </div>
                </form>
            </div>
        </div>
    </div>
</div
