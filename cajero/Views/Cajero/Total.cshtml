@model Application.ViewModels.RetiroVewModel

<div class="row">
    <div class="col-4 offset-4">
        <div class="card">
            <div class="card-header bg-primary text-light">
                <strong>Total Retirado</strong>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p>@Model.configuracion</p>
                </div>
                <div class="mb-3">
                    <p>@Model.resultado</p>
                </div>
                <div>
                    <a asp-controller="Cajero" asp-action="index" class="btn btn-outline-warning float-end me-2">Volver a Inicio</a>
                </div>
            </div>
        </div>
    </div>
</div>
